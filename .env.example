# ==============================================================================
# SMART AI-BASED CCTV ATTENDANCE LEDGER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the root directory and/or in `backend/` & `frontend/`.
# 2. Fill in the values as detailed below.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Where to get these from Supabase:
# - Log in to https://supabase.com/dashboard
# - Select your project (or create a new project)
# - Go to: Project Settings -> Database (or "Connect" button in the top bar)
# - Look for "Connection string" -> URI mode (choose "Transaction" or "Session" pooler, or Direct)
# - Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#   or Session Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# NOTE: If left empty or using sqlite, the system automatically falls back to local SQLite database (sqlite:///./attendance.db)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Project URL and Public Anon Key (Optional for direct client/storage integration)
# Where to get: Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys (anon public)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode: development / production / testing
ENVIRONMENT=development
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security secret key for JWT token hashing (Generate a random 32+ character hex string or string)
# You can generate one via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate_and_put_random_32_char_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_NAME="Smart CCTV Attendance Ledger"
NEXT_PUBLIC_APP_VERSION="1.0.0"
